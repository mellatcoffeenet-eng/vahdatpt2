            width: 250px;
            background: #fff;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            text-decoration: none;
            border: 2px solid #f0f0f0;
        }
        .disease-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.2);
            border-color: #007aff;
        }
        .disease-card-img {
            width: 100%;
            height: 140px;
            object-fit: cover;
            display: block;
            border-bottom: 3px solid #007aff;
        }
        .disease-card-body {
            padding: 15px;
            text-align: center;
        }
        .disease-card-arrow {
            color: #ff0000;
            font-size: 22px;
            font-weight: bold;
            margin-left: 5px;
        }
        .disease-card-title {
            font-size: 17px;
            color: #333;
            font-weight: bold;
        }
        .share-section {
            text-align: center;
            padding: 20px 0 0;
            border-top: 2px solid #f0f0f0;
            margin-top: 30px;
        }
        .share-btn {
            display: inline-flex; align-items: center; gap: 8px;
            background: #f0f7ff; color: #007aff; padding: 10px 25px;
            border-radius: 25px; font-size: 15px; transition: all 0.3s;
            border: none; cursor: pointer; font-weight: bold;
        }
        .share-btn:hover { background: #007aff; color: #fff; }
        .back-btn {
            display: inline-block; background: #007aff; color: #fff;
            padding: 12px 25px; border-radius: 25px; margin: 20px;
            transition: all 0.3s; font-size: 15px; text-decoration: none;
        }
        .back-btn:hover { background: #0056b3; transform: translateX(-5px); }
        @media (max-width: 768px) {
            .page-header { flex-direction: column; text-align: center; }
            .page-title { font-size: 22px; }
            .disease-card { width: 200px; }
            .disease-card-img { height: 120px; }
        }
        @media (max-width: 480px) {
            .disease-cards { flex-direction: column; align-items: center; }
            .disease-card { width: 100%; max-width: 300px; }
        }
